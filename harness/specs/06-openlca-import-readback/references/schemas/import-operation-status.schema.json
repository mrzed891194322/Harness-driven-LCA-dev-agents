{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whole-lca/import-operation-status.schema.json",
  "title": "openLCA import operation journal status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "report"],
  "properties": {
    "schema": {"const": "whole-lca/import-operation-status"},
    "version": {"const": "1.0"},
    "status": {"enum": ["not_found", "indeterminate", "running", "success", "partial_failure", "failed", "rejected"]},
    "report": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "import-report.schema.json"}
      ]
    },
    "error": {"type": "string"}
  }
}
