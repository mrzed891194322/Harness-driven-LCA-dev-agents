{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revise-lca/revision-brief.schema.json",
  "title": "Revise-LCA revision brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "baseline_manifest_path", "feedback_path", "changes", "unchanged_decisions"],
  "properties": {
    "schema": {"const": "revise-lca/revision-brief"},
    "version": {"const": "1.0"},
    "baseline_manifest_path": {"type": "string", "minLength": 1},
    "feedback_path": {"type": "string", "minLength": 1},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "request", "affected_artifacts", "acceptance_criteria", "evidence_refs", "status"],
        "properties": {
          "change_id": {"type": "string", "pattern": "^REV-[A-Z0-9-]+$"},
          "request": {"type": "string", "minLength": 1},
          "affected_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["planned", "implemented", "not_implemented"]}
        }
      }
    },
    "unchanged_decisions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
