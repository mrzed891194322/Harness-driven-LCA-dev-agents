{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whole-lca/workflow-manifest.schema.json",
  "title": "Whole-LCA workflow manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "platform", "orchestrator_agent", "plan", "started_at", "updated_at", "status", "lci_review_attempt", "artifact_index"],
  "properties": {
    "schema": {"const": "whole-lca/workflow-manifest"},
    "version": {"const": "2.0"},
    "platform": {"type": "string", "minLength": 1},
    "orchestrator_agent": {"const": "major-orchestrator"},
    "plan": {"$ref": "whole-lca/common.schema.json#/$defs/artifact"},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["not_started", "running", "failed", "completed"]},
    "status_reason": {"type": ["string", "null"]},
    "current_stage": {"type": ["string", "null"]},
    "import_scope": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "whole-lca/common.schema.json#/$defs/import_scope"}
      ]
    },
    "lci_review_attempt": {"type": "integer", "minimum": 0, "maximum": 3},
    "artifact_index": {"type": "array", "items": {"$ref": "whole-lca/common.schema.json#/$defs/artifact"}},
    "issue_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["failed", "completed"]}},
        "required": ["status"]
      },
      "then": {
        "required": ["status_reason"],
        "properties": {
          "status_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
