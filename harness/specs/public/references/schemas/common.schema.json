{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whole-lca/common.schema.json",
  "title": "Whole-LCA shared schema fragments",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator"],
      "properties": {
        "type": {"enum": ["openlca", "user-file", "standard", "tool"]},
        "locator": {"type": "string", "minLength": 1},
        "tool": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "import_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_name", "category", "lci_dir"],
      "properties": {
        "database_name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "lci_dir": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "basis": {"type": "string"},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/source"}
        },
        "source_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "revision_of": {"type": ["string", "null"]},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
