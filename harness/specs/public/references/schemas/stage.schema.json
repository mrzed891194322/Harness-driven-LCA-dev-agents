{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whole-lca/stage.schema.json",
  "title": "Whole-LCA stage record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "stage_id", "supersedes_stage_id", "sequence", "stage", "agent", "started_at", "ended_at", "status", "artifact_ids", "evidence_refs", "issue_ids", "basis", "sources"],
  "properties": {
    "schema": {"const": "whole-lca/stage"},
    "version": {"const": "2.0"},
    "stage_id": {"type": "string", "pattern": "^stage-[0-9]{3}-[a-z0-9-]+$"},
    "supersedes_stage_id": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 1},
    "stage": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["running", "passed", "failed"]},
    "artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "issue_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "basis": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "items": {"$ref": "whole-lca/common.schema.json#/$defs/source"}
    },
    "summary": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "failed"}},
        "required": ["status"]
      },
      "then": {
        "required": ["summary"],
        "properties": {
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
