{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness/specs/02-inventory-extraction/extracted-bom.schema.json",
  "title": "Extracted BOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "item_id",
          "name",
          "quantity",
          "unit",
          "process",
          "transport",
          "geography",
          "source_locations",
          "extraction_status"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": ["number", "null"]
          },
          "unit": {
            "type": ["string", "null"]
          },
          "process": {
            "type": ["string", "null"]
          },
          "transport": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "properties": {
              "mode": {
                "type": ["string", "null"]
              },
              "distance_km": {
                "type": ["number", "null"]
              }
            }
          },
          "geography": {
            "type": ["string", "null"]
          },
          "source_locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraction_status": {
            "type": "string",
            "enum": ["extracted", "partial", "unreadable"]
          },
          "gap": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
