{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whole-lca/calculation-manifest.schema.json",
  "title": "Whole-LCA calculation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "active_database", "impact_method", "tool_versions", "calculated_at", "calculations", "comparison_checks", "unresolved_items"],
  "properties": {
    "schema": {"const": "whole-lca/calculation-manifest"},
    "version": {"const": "3.0"},
    "status": {"enum": ["success", "failed"]},
    "active_database": {"type": "string", "minLength": 1},
    "impact_method": {"$ref": "#/$defs/ref"},
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "calculated_at": {"type": "string", "format": "date-time"},
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/calculation"}
    },
    "comparison_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison_check"}
    },
    "unresolved_items": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {
        "properties": {
          "calculations": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/calculation"},
                {"properties": {"status": {"const": "success"}, "resource_released": {"const": true}}}
              ]
            }
          },
          "comparison_checks": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/comparison_check"},
                {"properties": {"status": {"enum": ["distinct", "explained"]}}}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "raw_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "product_system", "functional_unit_amount", "allocation", "regionalized", "costs", "parameters", "calculated_at", "raw_result", "resource_released"],
      "properties": {
        "status": {"enum": ["success", "failed"]},
        "product_system": {"$ref": "#/$defs/ref"},
        "functional_unit_amount": {"type": "number", "exclusiveMinimum": 0},
        "allocation": {"type": ["string", "null"]},
        "regionalized": {"type": "boolean"},
        "costs": {"type": "boolean"},
        "parameters": {"type": "object", "additionalProperties": {"type": "number"}},
        "calculated_at": {"type": "string", "format": "date-time"},
        "raw_result": {"$ref": "#/$defs/raw_result"},
        "resource_released": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "success"}}},
          "then": {"properties": {"resource_released": {"const": true}}}
        }
      ]
    },
    "comparison_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_product_system_id", "right_product_system_id", "results_equal", "status", "explanation"],
      "properties": {
        "left_product_system_id": {"type": "string", "minLength": 1},
        "right_product_system_id": {"type": "string", "minLength": 1},
        "results_equal": {"type": "boolean"},
        "status": {"enum": ["distinct", "explained"]},
        "explanation": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"results_equal": {"const": true}}},
          "then": {"properties": {"status": {"enum": ["explained"]}}}
        },
        {
          "if": {
            "properties": {
              "results_equal": {"const": true},
              "status": {"const": "explained"}
            },
            "required": ["results_equal", "status"]
          },
          "then": {
            "properties": {
              "explanation": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"results_equal": {"const": false}}},
          "then": {"properties": {"status": {"const": "distinct"}}}
        }
      ]
    }
  }
}
