# 本文件是模板。首次引导或 Web 设置保存时，缺失的 .env 会从这里复制。
# 请在仓库根目录的 .env 里填写实际值；不要把密钥提交进 git。
# 模型 API 密钥写入 Web「设置」或 `.local/credentials/`（不回显、不进 Git）。

# ---------------------------------------------------------------------------
# 旧字段。计划页的默认模型保存在 .local/workflow-models.json，不读这一项。
# 档案定义仍见 src/backend/core/runtime/model_profiles.json。
# ---------------------------------------------------------------------------
PI_MODEL="default"

# 兼容旧配置：若存在则忽略非 pi 值
# HARNESS_AGENT="pi"

# ---------------------------------------------------------------------------
# 包缓存：启动器固定用仓库根 .cache/uv / .cache/npm，不需要设置
# ---------------------------------------------------------------------------
# UV_CACHE_DIR=".cache/uv"
# npm_config_cache=".cache/npm"
# BENCHMARK_CACHE=".cache/benchmark"

# ---------------------------------------------------------------------------
# 控制面板端口（npm run dev 同时启动前端与后端）
# ---------------------------------------------------------------------------
GUI_WEB_PORT="3000"
GUI_API_PORT="8800"

# ---------------------------------------------------------------------------
# openLCA
# ---------------------------------------------------------------------------
OPENLCA_IPC_HOST="127.0.0.1"
OPENLCA_IPC_PORT="8080"

# ---------------------------------------------------------------------------
# v5 harness 模板变量（rules/specs 里的 {{language}}、{{project_category}}）。缺失时加载报错。
# OPENLCA_PROJECT_CATEGORY 必须等于代码里锁定的类别。
# ---------------------------------------------------------------------------
HARNESS_LANGUAGE="中文"
OPENLCA_PROJECT_CATEGORY="202606-harness-agent-LCA"

# 模型请求失败后的重试等待（秒，逗号分隔）；不填用代码默认 10,30,60。
# PI_MODEL_RETRY_DELAYS_S="10,30,60"
