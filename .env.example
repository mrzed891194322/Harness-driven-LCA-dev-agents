# 本文件是模板。首次引导或 GUI 保存设置时，缺失的 .env 会从这里复制。
# 请在仓库根目录的 .env 里填写实际值；不要把密钥提交进 git。
# GUI「设置&初始化」点「AI Agent 工具」卡片「配置」可编辑各 CLI 的模型 id。
# 认证走各官方 CLI 的本机登录（如 codex login / claude auth login / opencode auth login / pi /login），
# 不要把 API Key 写进本文件。

# ---------------------------------------------------------------------------
# Worker 后端：codex | claude | opencode | pi（缺省 codex）
# ---------------------------------------------------------------------------
HARNESS_AGENT="codex"

# ---------------------------------------------------------------------------
# 各 CLI 使用的模型 id（文本，可改）
# Pi / OpenCode 留空则使用本机已保存的默认模型。
# OpenCode 模型格式为 provider/model，例如 anthropic/claude-sonnet-4-5。
# ---------------------------------------------------------------------------
CODEX_MODEL="gpt-5.4"
CLAUDE_MODEL="claude-sonnet-4-5"
OPENCODE_MODEL=""
PI_MODEL=""

# ---------------------------------------------------------------------------
# 端口与 openLCA
# ---------------------------------------------------------------------------
GUI_PORT="7860"
OPENLCA_IPC_HOST="127.0.0.1"
OPENLCA_IPC_PORT="8080"
# OPENLCA_DATABASE_NAME=""
# 只读 IPC 单次读超时（秒）；预检/导入/计算/清理使用 LONG 值
# OPENLCA_IPC_READ_SEC="30"
# OPENLCA_IPC_LONG_READ_SEC="600"
# import_lci 等长作业在同一把 endpoint 锁内的总 IPC 预算（秒）
# OPENLCA_IPC_SESSION_BUDGET_SEC="7200"
# Agent 可在 MCP 长工具上显式传 timeout_sec（300–7200，默认与上项一致）；勿用 shell timeout 包裹
